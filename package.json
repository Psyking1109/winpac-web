{
  "name": "winpac-web",
  "version": "1.0.0",
  "private": true,
  "description": "WINPAC Trading Company website: Vue 3 + Node.js/Express + SQLite",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config client/vite.config.mjs\"",
    "build": "vite build --config client/vite.config.mjs",
    "start": "node server/index.js",
    "create-admin": "node server/create-admin.js",
    "backup": "node server/backup.js",
    "setup": "node server/setup.js",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:8080",
    "build:preview": "node server/build-preview-data.js && VITE_PREVIEW=1 vite build --config client/vite.config.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^9.0.1",
    "pinia": "^2.2.2",
    "vite": "^5.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.4",
    "vue-router": "^4.4.3"
  }
}