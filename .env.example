# Only needed for a permanent server. For testing, start-test.bat creates .env for you.

# Your domain, e.g. winpac.lk
DOMAIN=winpac.lk

# A long random secret for admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The first admin account, created on first start if none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-10-chars-or-more

# Optional
# PORT=8080
# DATA_DIR=./data       (database, photos and backups all live here)
# COOKIE_SECURE=1       (on by default when NODE_ENV=production)
# TRUST_PROXY=1         (set when behind Caddy, nginx or Cloudflare)
